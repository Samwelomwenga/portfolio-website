# Copy this file to `.env.local` and fill in real values.

# --- Server-only secrets (never exposed to the browser) ---

# Google Generative AI (Gemini) API key. This is the Vercel AI SDK's default
# env name for the `@ai-sdk/google` provider, so no extra wiring is needed.
# When missing, the assistant serves its offline state (HTTP 503) instead of
# calling the model.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini model override. Defaults to `gemini-3.5-flash` when unset.
ASSISTANT_MODEL=

# --- Public client-side identifiers (safe to expose in the browser bundle) ---

# Formspree form id for the contact form.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Google reCAPTCHA v3 site key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
